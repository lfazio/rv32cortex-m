-            get_desc(s, &desc, queue_idx, desc_idx);
+            if (get_desc_checked(s, &desc, queue_idx, desc_idx, &hops) < 0)
+                return -1;
         }
     } else {
         f_write_flag = 0;
@@ -414,7 +437,8 @@ static int memcpy_to_from_queue(VIRTIODevice *s, uint8_t *buf,
             return -1;
         desc_idx = desc.next;
         offset -= desc.len;
-        get_desc(s, &desc, queue_idx, desc_idx);
+        if (get_desc_checked(s, &desc, queue_idx, desc_idx, &hops) < 0)
+            return -1;
     }
 
     for(;;) {
@@ -432,7 +456,8 @@ static int memcpy_to_from_queue(VIRTIODevice *s, uint8_t *buf,
             if (!(desc.flags & VRING_DESC_F_NEXT))
                 return -1;
             desc_idx = desc.next;
-            get_desc(s, &desc, queue_idx, desc_idx);
+            if (get_desc_checked(s, &desc, queue_idx, desc_idx, &hops) < 0)
+                return -1;
             if ((desc.flags & VRING_DESC_F_WRITE) != f_write_flag)
                 return -1;
             offset = 0;
@@ -482,30 +507,37 @@ static int get_desc_rw_size(VIRTIODevice *s,
                              int queue_idx, int desc_idx)
 {
     VIRTIODesc desc;
-    int read_size, write_size;
+    int read_size, write_size, hops = 0;
 
     read_size = 0;
     write_size = 0;
-    get_desc(s, &desc, queue_idx, desc_idx);
+    if (get_desc_checked(s, &desc, queue_idx, desc_idx, &hops) < 0)
