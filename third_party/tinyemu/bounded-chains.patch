+/* rv32cortex-m: the guest writes every descriptor, so a chain is bounded
+   -- in length, as the queue size bounds it (virtio 1.1, 2.6.5), and in
+   bytes, so that sums of lengths stay in an int -- and a descriptor that
+   could not be read ends it rather than being used uninitialised. A
+   cycle in a chain followed `next` for ever (fuzz-virtio). See
+   README.md, "What is modified". */
+#define VIRTIO_MAX_CHAIN 256
+#define VIRTIO_MAX_CHAIN_BYTES (64 * 1024 * 1024)
+
+static int get_desc_checked(VIRTIODevice *s, VIRTIODesc *desc,
+                            int queue_idx, int desc_idx, int *hops)
+{
+    if (++*hops > VIRTIO_MAX_CHAIN)
+        return -1;
+    if (get_desc(s, desc, queue_idx, desc_idx) < 0)
+        return -1;
+    if (desc->len > VIRTIO_MAX_CHAIN_BYTES)
+        return -1;
+    return 0;
+}
+
 static int memcpy_to_from_queue(VIRTIODevice *s, uint8_t *buf,
                                 int queue_idx, int desc_idx,
                                 int offset, int count, BOOL to_queue)
 {
     VIRTIODesc desc;
-    int l, f_write_flag;
