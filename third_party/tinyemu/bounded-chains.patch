+    if (get_desc_checked(s, &desc, queue_idx, desc_idx, &hops) < 0)
+        return -1;
 
     if (to_queue) {
         f_write_flag = VRING_DESC_F_WRITE;
@@ -398,7 +420,8 @@ static int memcpy_to_from_queue(VIRTIODevice *s, uint8_t *buf,
             if (!(desc.flags & VRING_DESC_F_NEXT))
                 return -1;
