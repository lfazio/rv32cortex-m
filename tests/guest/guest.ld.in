/* SPDX-License-Identifier: Apache-2.0 */
/*
 * guest.ld - Link script for RV32 guest images.
 *
 * Generated from guest.ld.in: LENGTH is substituted from
 * EMU_GUEST_RAM_KIB so it always matches the RAM the emulator actually
 * maps at RV_GUEST_RAM_BASE. Getting this wrong is not a link error --
 * _stack_top simply ends up past the end of guest RAM, and the guest takes
 * a store access fault on its first push, before it has installed a trap
 * handler that could report it.
 *
 * Everything lands in one contiguous RAM region starting at the guest
 * reset address, so the resulting flat binary can be loaded at 0x80000000
 * and entered at offset 0.
 */

OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY
{
    RAM (rwx) : ORIGIN = 0x80000000, LENGTH = @EMU_GUEST_RAM_KIB@K
}

SECTIONS
{
    .text : ALIGN(4)
    {
        KEEP(*(.text.init))     /* _start must be first: entry is at +0 */
        *(.text .text.*)
    } > RAM

    .rodata : ALIGN(4)
    {
        *(.rodata .rodata.*)
        *(.srodata .srodata.*)
        /*
         * Inside the section, not after it. The ALIGN(4) below sets
         * __guest_ro_end correctly but sits *between* output sections,
         * so it only moves the location counter -- the .rodata section's
         * own extent is unchanged, and `objcopy -j .text -j .rodata`
         * emits bytes up to the end of its contents. The two halves then
         * do not reconstruct the image: hello came out 393 + 4 against a
         * 400-byte binary, losing the three padding bytes, so .data was
         * placed three bytes below where the guest reads it.
         *
         * It bites only when .rodata happens to end unaligned, which is
         * why it went unnoticed -- coremark and isatest are aligned by
         * luck and are byte-exact, hello and cmsistest are not.
         */
        . = ALIGN(4);
    } > RAM

    /*
     * Where the read-only half ends.
     *
     * On the STM32 the guest image is already resident in the part's
     * flash -- guest_image.S embeds it in the firmware -- and the boot
     * path then memcpy's the whole thing into guest RAM. Everything up
     * to here is read-only and does not need that copy: it can be served
     * straight out of flash as a ROM bus region, leaving RAM for the
     * half that is actually written. On the biggest architecture tests
     * that is 140 KiB of the 345 they need.
     *
     * The split has to be *exact*. In the flat binary .data follows
     * immediately with no marker, so a boundary that is off by any
     * amount either serves initialised data from flash -- where the
     * guest's first write to it faults -- or leaves the tail of .rodata
     * uncopied and reading as zero. Hence a linker symbol rather than an
     * offset computed anywhere else.
     *
     * ALIGN(4) before it, because a ROM region's end and the RAM
     * region's base are the same address and both want to be aligned.
     */
    . = ALIGN(4);
    __guest_ro_end = .;

    .data : ALIGN(4)
    {
        *(.data .data.*)
        /*
         * __global_pointer$ addresses the middle of the small-data area so
         * a signed 12-bit offset from gp reaches all of it.
         */
        . = ALIGN(8);
        PROVIDE(__global_pointer$ = . + 0x800);
        *(.sdata .sdata.*)
    } > RAM

    .bss (NOLOAD) : ALIGN(4)
    {
        __bss_start = .;
        *(.sbss .sbss.*)
        *(.bss .bss.*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end = .;
    } > RAM

    . = ALIGN(16);
    _end = .;

    /* Stack grows down from the top of RAM. */
    _stack_top = ORIGIN(RAM) + LENGTH(RAM);

    /DISCARD/ : { *(.comment) *(.note.*) *(.riscv.attributes) }
}
