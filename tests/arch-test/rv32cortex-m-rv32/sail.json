{
  // Sail golden-model configuration matching rv32cortex-m.
  //
  // ACT runs the Sail model to compute the expected results that get baked
  // into each self-checking test, so this must describe the same machine
  // the emulator implements: same memory map, same trap behaviour, same
  // extension set. Where the two disagree, the tests fail for the wrong
  // reason.
  "base": {
    "xlen": 32,
    "E": false,
    // The extension set is fixed at build time (rv_hart_misa).
    "writable_misa": false,
    "writable_fiom": false,
    "writable_hpm_counters": {
      "len": 32,
      "value": "0x00000000"
    },
    // No S or U mode, so these counter-enable CSRs have nothing to grant.
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0x0"
    },
    // Both mtvec modes are supported. Only the low two bits are masked, so
    // BASE needs 4-byte (2^2) alignment.
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    // stvec takes the same WARL rule as mtvec: both modes, and only the low
    // two bits masked, so BASE needs 4-byte (2^2) alignment.
    "stvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    // What may be delegated, matching MEDELEG_WMASK and MIDELEG_WMASK.
    // Both were 0x0 while there was no S-mode to delegate to, and leaving
    // them so once S exists does not merely under-describe the hart -- it
    // makes the golden model take in M-mode every trap the emulator
    // correctly hands to S, so the signatures disagree on the one field
    // that is right.
    //
    // medeleg: causes 0 through 9, which is everything this core can raise
    // except ECALL from M. The page faults are absent because with Bare
    // translation nothing can raise them.
    "medeleg": {
      "delegatable_bits": {
        "len": 64,
        "value": "0x3ff"
      }
    },
    // mideleg: the three supervisor interrupts, SSIP/STIP/SEIP.
    "mideleg": {
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x222"
      }
    },
    // rv_hart_trap records the faulting address for every address-related
    // cause, the pc for breakpoints, and the encoding for illegal
    // instructions. Nothing here is hardwired to zero.
    "xtval_nonzero": {
      "illegal_instruction": true,
      "software_breakpoint": true,
      "hardware_breakpoint": false,
      "load_address_misaligned": true,
      "load_access_fault": true,
      /* The three page-fault causes report the faulting *virtual* address,
         which is what the walk was given and the only thing a handler can
         use to find the mapping. They were false while there was no
         translation and nothing could raise them, and had to move with
         Sv32 -- they must equal the REPORT_VA_IN_xTVAL_ON_*_PAGE_FAULT
         parameters in the UDB config, which say the same thing to the
         other model. */
      "load_page_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true,
      "fetch_page_fault": true,
      "software_check": false,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      // A reserved mtvec MODE keeps the previous value (WARL).
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      // No FPU and no vector unit.
      "fs_legal_states": "ExtContext_FourState",
      "vs_legal_states": "ExtContext_Off"
    },
    "privileged_isa_version": "Privileged_ISA_1_12"
  },
  "memory": {
    "physaddr_bits": 32,
    // 16 entries, matching RV_PMP_ENTRIES. Zero here is the Zacas mistake
    // again: sail.json configures the golden model that bakes each test's
    // expected values, and a model with no PMP registers can deny nothing,
    // so it would generate permissive expectations for every test that
    // configures PMP -- which then reads as an emulator bug.
    //
    // grain is the privileged spec's G, so 0 means a 4-byte granule, which
    // is what NA4 support requires. Note this is *not* the same units as
    // UDB's PMP_GRANULARITY, which is log2 of the granule in bytes and is
    // therefore 2 for the same thing.
    "pmp": {
      "grain": 0,
      "count": 16,
      "usable_count": 16,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    // This core reports misaligned accesses rather than splitting them.
    "misaligned": {
      "byte_by_byte": false,
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "exceptions": {
        "load_store": { "Some": "AlignmentException" },
        "vector": { "None": null },
        "lrsc": "AlignmentException",
        "amo": { "Some": "AlignmentException" }
      }
    },
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    // The guest memory map from include/rv32/rv_memmap.h. Anything not
    // listed is unmapped and faults, which is what makes
    // RVMODEL_ACCESS_FAULT_ADDRESS (0x70000000) work.
    "regions": [
      {
        // CLINT
        "base": { "len": 64, "value": "0x2000000" },
        "size": { "len": 64, "value": "0xC000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      {
        // Sail's simple_interrupt_generator. ACT requires this device for
        // signature generation even though this DUT has no external
        // interrupt controller, so it is parked at an address the emulator
        // leaves unmapped. The RVMODEL_SET/CLR_MEXT_INT macros are empty,
        // so no generated test ever accesses it on the DUT side.
        "base": { "len": 64, "value": "0x2100000" },
        "size": { "len": 64, "value": "0x1000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      {
        // Virtual console UART
        "base": { "len": 64, "value": "0x10000000" },
        "size": { "len": 64, "value": "0x1000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AlignmentException"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      {
        // Guest RAM. Matches RAM_ORIGIN/RAM_LENGTH in link.ld.
        "base": { "len": 64, "value": "0x80000000" },
        "size": { "len": 64, "value": "0x800000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "Some": "AlignmentException" },
            "vector": { "None": null },
            "amo": "AlignmentException"
          },
          /* AMOCASD covers amocas.w and amocas.d as well as the arithmetic
             and logical AMOs. Declaring only AMOArithmetic here makes the
             golden model *trap* on amocas, and the expected signatures are
             then generated from that trap rather than from the operation. */
          "atomic_support": "AMOCASD",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": true,
          /* A page table lives in ordinary guest RAM, so this region has to
             admit that it can hold one. Declaring false was right while
             there was no paging; left false once Sv32 exists, the golden
             model fails the *PTE read* with a memory-access error and bakes
             an access fault into the signature where the architecture calls
             for a page fault -- the same shape as the atomic_support
             mistake above, and just as invisible, because the emulator is
             behaving correctly and the reference is not being asked the
             right question.

             pte_write stays false: this core implements Svade, so the walk
             checks A and D and raises a page fault rather than writing them
             back. A model permitted to update them in place would disagree
             with every A/D test, for the right reason. */
          "supports_pte_read": true,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      }
    ]
  },
  "platform": {
    // Non-commercial implementation: mvendorid reads as zero.
    "vendorid": 0,
    "archid": 0,
    "impid": 65536,
    "hartid": 0,
    "cache_block_size_exp": 5,
    // The reservation is a single word compared by exact address, and any
    // store from this hart to it clears it (see rv_hart_store).
    "reservation": {
      "reservation_set_size_exp": 2,
      "require_exact_reservation_addr": true,
      "invalidate_on_same_hart_store": true
    },
    "clint": {
      "supported": true,
      "base": 33554432,
      "size": 49152
    },
    // Required by ACT's signature generation. The emulator has no external
    // interrupt controller; see the matching memory region above.
    "simple_interrupt_generator": {
      "supported": true,
      "base": 34603008
    },
    "clock_frequency": 1000000000,
    // The interpreter retires one instruction per modelled cycle and bumps
    // mcycle in the same step (see rv_interp.c), so the clock ticks once
    // per instruction. Leaving this at a larger value makes the golden
    // model's cycle counter advance more slowly than the DUT's, and the
    // Zicntr counter tests then bake in the wrong expected deltas.
    "instructions_per_tick": 1,
    "wfi_is_nop": true,
    "wfi_available_to_user_mode": false,
    "max_time_to_wait": 0
  },
  "extensions": {
    "U": { "supported": true },
    "S": { "supported": true },
    "M": { "supported": true },
    "A": { "supported": true },
    "F": {
      "supported": true,
      "fflags_dirty_policy": "Fflags_Dirty_Precise"
    },
    "D": { "supported": false },
    "V": {
      "support_level": "Disabled",
      "vlen_exp": 7,
      "elen_exp": 6,
      "reserved_behavior": {
        "illegal_vtype": "IllegalVtype_SetVill",
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      "max_index_eew_exp": 5,
      "vstart": {
        "zero_required": {
          "arith": true,
          "scalar_move": true
        }
      }
    },
    "B": { "supported": true },
    "Zibi": { "supported": false },
    "Zicbom": { "supported": true },
    "Zicbop": { "supported": false },
    "Zicboz": { "supported": true },
    "Zic64b": { "supported": false },
    "Ziccamoa": { "supported": false },
    "Ziccamoc": { "supported": false },
    "Ziccif": { "supported": false },
    "Zicclsm": { "supported": false },
    "Ziccrse": { "supported": false },
    "Zicfilp": { "supported": false },
    "Zicfiss": { "supported": false },
    "Zicond": { "supported": false },
    "Zicntr": { "supported": true },
    "Zicsr": { "supported": true },
    "Zifencei": { "supported": true },
    "Zihintntl": { "supported": false },
    "Zihintpause": { "supported": false },
    "Zihpm": { "supported": false },
    "Zimop": { "supported": false },
    "Zmmul": { "supported": true },
    "Zaamo": { "supported": true },
    "Zabha": { "supported": false },
    "Zacas": { "supported": true },
    "Zalrsc": { "supported": true },
    "Zama16b": { "supported": false },
    "Zawrs": {
      "supported": false,
      "nto": { "is_nop": false },
      "sto": { "is_nop": false }
    },
    "Zfa": { "supported": false },
    "Zfbfmin": { "supported": false },
    "Zfh": { "supported": false },
    "Zfhmin": { "supported": false },
    "Zfinx": { "supported": false },
    "Zdinx": { "supported": false },
    "Zca": { "supported": true },
    "Zcf": { "supported": true },
    "Zcd": { "supported": false },
    // Zcb is not implemented: those encodings raise illegal instruction.
    "Zcb": { "supported": true },
    "Zcmop": { "supported": false },
    "Zba": { "supported": true },
    "Zbb": { "supported": true },
    "Zbs": { "supported": true },
    "Zbc": { "supported": true },
    "Zbkb": { "supported": false },
    "Zbkc": { "supported": false },
    "Zbkx": { "supported": false },
    "Zknd": { "supported": false },
    "Zkne": { "supported": false },
    "Zknh": { "supported": false },
    "Zkr": {
      "supported": false,
      "sseed_reset_value": false,
      "useed_reset_value": false,
      "sseed_read_only_zero": false,
      "useed_read_only_zero": false
    },
    "Zksed": { "supported": false },
    "Zksh": { "supported": false },
    "Zkt": { "supported": false },
    "Zhinx": { "supported": false },
    "Zhinxmin": { "supported": false },
    "Ssccptr": { "supported": false },
    "Sscofpmf": { "supported": false },
    "Sscounterenw": { "supported": false },
    "Sstc": { "supported": false },
    "Sstvala": { "supported": false },
    "Svinval": { "supported": false },
    "Svrsw60t59b": { "supported": false },
    "Smcntrpmf": { "supported": false },
    "Svbare": {
      "supported": false,
      "sfence_vma_illegal_if_svbare_only": true
    },
    // The walk checks A and D and raises a page fault; it never writes the
    // PTE. Leaving this false lets the golden model update them in place
    // and then disagree with every A/D test for the right reason.
    "Svade": { "supported": true },
    "Svadu": { "supported": false },
    "Svnapot": { "supported": false },
    "Ssnpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smnpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smmpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Svpbmt": { "supported": false },
    "Svvptc": { "supported": false },
    // Sv32 paging, with Svade -- the walk checks A and D and faults rather
    // than writing the PTE.
    "Sv32": { "supported": true },
    "Sv39": { "supported": false },
    "Sv48": { "supported": false },
    "Sv57": { "supported": false },
    "Stateen": {
      "Smstateen": { "supported": false },
      "Ssstateen": { "supported": false },
      "C_readonly_zero": true,
      "SE0_readonly_zero": false
    },
    "Ssqosid": {
      "supported": false,
      "rcid_length": 12,
      "mcid_length": 12
    },
    "Zvabd": { "supported": false },
    "Zvbb": { "supported": false },
    "Zvbc": { "supported": false },
    "Zvfbfmin": { "supported": false },
    "Zvfbfwma": { "supported": false },
    "Zvfh": { "supported": false },
    "Zvfhmin": { "supported": false },
    "Zvkb": { "supported": false },
    "Zvkg": { "supported": false },
    "Zvkned": { "supported": false },
    "Zvknha": { "supported": false },
    "Zvknhb": { "supported": false },
    "Zvksed": { "supported": false },
    "Zvksh": { "supported": false },
    "Zvkt": { "supported": false }
  }
