#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""
emu-board - run one guest on the Nucleo, as if it were emu-host.

This is the shim that lets the existing suites run on hardware without
knowing they are:

    EMU_HOST=scripts/emu-board ./scripts/run-riscv-tests.sh
    EMU_HOST=scripts/emu-board ./scripts/run-arch-test.sh --jobs 1

Both scripts invoke the runner as `<runner> [options] <image>` and read
its exit status, so that is exactly what this presents. The options are
accepted and mostly ignored: --ram and --max-insn are properties of the
firmware, fixed when it was flashed, and silently accepting them is
right because the alternative is every caller special-casing the board.

How a run happens:

  1. the image is pushed over TFTP, once: an ELF stripped of its debug
     sections, which the board places by its program headers; a flat
     image given --load wrapped in an ELF of one segment at that address,
     so the board copies it to RAM -- riscv-tests are linked there and
     write to their own image; any other flat image as it is
  2. the console is read over telnet until the board's terminator line
  3. everything the guest printed goes to stdout, and the guest's exit
     status becomes this process's

It pushed two halves, `rom` then `ram`, until the board took one file in
August -- after which each half arrived as an image of its own, and
nothing ran this to notice.

The board is one piece of hardware, so runs are serialised with a lock
file. run-arch-test.sh defaults --jobs to nproc, and without the lock
eight workers would interleave uploads into one flash arena and read
each other's output.

Requires the SLIP link to be up (scripts/slip-tun.py).
"""

import argparse
import fcntl
import os
import re
import socket
import struct
import subprocess
import sys
import tempfile
import time

BOARD = os.environ.get("EMU_NET_ADDR", "192.168.7.2")
TFTP_PORT = 69
TELNET_PORT = 23
LOCK = os.environ.get("EMU_BOARD_LOCK", "/tmp/emu-board.lock")
# Where a flat image runs in place: EMU_GUEST_ROM_BASE.
ROM_BASE = 0x20000000

# The board prints this last, for every run. It is the only thing that
# says a run is over: there is no process to exit.
RESULT_RE = re.compile(
    r"emu-result exit=(\d+) exited=(\d+) capped=(\d+) retired=(\d+)")


# ------------------------------------------------------------------
# Preparing the image
# ------------------------------------------------------------------

EM_RISCV = 243


def objcopy():
    for name in ("riscv64-unknown-elf-objcopy", "riscv32-unknown-elf-objcopy",
                 "riscv64-elf-objcopy"):
        p = subprocess.run(["which", name], capture_output=True)
        if p.returncode == 0:
            return name
    return None


def flat_as_elf(blob, load):
    """An ELF32 RISC-V executable of one RWX segment: `blob` at `load`."""
    ehsize, phsize = 52, 32
    off = ehsize + phsize
    ident = b"\x7fELF" + bytes([1, 1, 1]) + bytes(9)
    eh = ident + struct.pack("<HHIIIIIHHHHHH", 2, EM_RISCV, 1, load, ehsize,
                             0, 0, ehsize, phsize, 1, 40, 0, 0)
    ph = struct.pack("<IIIIIIII", 1, off, load, load, len(blob), len(blob),
                     7, 4)
    return eh + ph + blob


def prepare_image(path, load, tmpdir):
    """The bytes to upload, and what they are, for the log."""
    with open(path, "rb") as f:
        data = f.read()

    if data[:4] == b"\x7fELF":
        oc = objcopy()
        if oc is None:
            return data, "ELF"
        out = os.path.join(tmpdir, "image.elf")
        subprocess.run([oc, "--strip-all", path, out], check=True)
        with open(out, "rb") as f:
            return f.read(), "ELF, stripped"

    if load is not None and int(load, 0) != ROM_BASE:
        return flat_as_elf(data, int(load, 0)), "flat, at %s" % load
    return data, "flat, in place"


# ------------------------------------------------------------------
# TFTP
# ------------------------------------------------------------------

def tftp_put(name, payload, timeout=20.0):
    """
    Minimal RFC 1350 write, in octet mode.

    Written out rather than shelling to curl or tftp: this is the inner
    loop of a 274-test suite, and the failure mode that matters -- a
    block going unacknowledged -- has to be retried here rather than
    reported as a dead board.
    """
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(2.0)
    try:
        req = b"\x00\x02" + name.encode() + b"\x00" + b"octet" + b"\x00"
        peer = (BOARD, TFTP_PORT)
        deadline = time.time() + timeout

        # WRQ, retried until the server answers with ACK 0.
        tid = None
        for _ in range(5):
            s.sendto(req, peer)
            try:
                pkt, addr = s.recvfrom(1024)
            except socket.timeout:
                continue
            if len(pkt) >= 4 and pkt[1] == 5:
                raise RuntimeError("tftp error: %s" % pkt[4:].split(b"\x00")[0].decode())
            if len(pkt) >= 4 and pkt[1] == 4 and struct.unpack(">H", pkt[2:4])[0] == 0:
                tid = addr
                break
        if tid is None:
            raise RuntimeError("tftp: no response to WRQ for %s" % name)

        block = 1
        off = 0
        while True:
            chunk = payload[off:off + 512]
            pkt = b"\x00\x03" + struct.pack(">H", block & 0xFFFF) + chunk
            acked = False
            for _ in range(5):
                s.sendto(pkt, tid)
                try:
                    resp, _ = s.recvfrom(1024)
                except socket.timeout:
                    if time.time() > deadline:
                        raise RuntimeError("tftp: timed out sending %s" % name)
                    continue
                if len(resp) >= 4 and resp[1] == 5:
                    raise RuntimeError(
                        "tftp error: %s" % resp[4:].split(b"\x00")[0].decode())
                if len(resp) >= 4 and resp[1] == 4 and \
                        struct.unpack(">H", resp[2:4])[0] == (block & 0xFFFF):
                    acked = True
                    break
            if not acked:
                raise RuntimeError("tftp: block %d unacknowledged" % block)

            off += len(chunk)
            block += 1
            # A short block ends the transfer -- including a zero-length
            # one, which is how an empty half is sent and is a legal
            # transfer rather than a no-op to be skipped.
            if len(chunk) < 512:
                return
    finally:
        s.close()


# ------------------------------------------------------------------
# Console
# ------------------------------------------------------------------

def strip_iac(buf):
    out, i = bytearray(), 0
    while i < len(buf):
        if buf[i] == 255 and i + 2 < len(buf):
            i += 3
            continue
        out.append(buf[i])
        i += 1
    return bytes(out)


def run_on_board(image, timeout):
    """Upload, then read the console until the board says the run ended."""
    sock = socket.create_connection((BOARD, TELNET_PORT), timeout=10)
    sock.settimeout(1.0)
    try:
        # Drain whatever the previous run left buffered, so the result
        # line matched below is this run's and not the last one's.
        try:
            while True:
                if not sock.recv(65536):
                    break
        except socket.timeout:
            pass

        # Retry once, because the *expected* failure here is the flash
        # arena filling up. There is no length in a TFTP request, so the
        # board discovers the end by running into it: the write fails,
        # it erases, and the next attempt succeeds. That is by design --
        # reserving a worst case up front would cost most of the packing
        # -- so one transfer in every dozen or so is meant to fail, and a
        # harness that treats it as an error reports a broken board once
        # per erase cycle.
        # The other retryable failure is "Only one connection at a time":
        # lwIP's TFTP server keeps a single session, and one abandoned by
        # a client that stopped answering stays open until *its* timeout
        # expires, not ours. Coming straight back gets refused again, and
        # because every later test then fails identically it looks like
        # the board died rather than like one transfer needing to age
        # out. Back off long enough for the server to give up.
        for attempt in (1, 2, 3):
            try:
                tftp_put("image", image)
                break
            except RuntimeError as e:
                if attempt == 3:
                    raise
                time.sleep(8.0 if "one connection" in str(e) else 1.0)

        buf = b""
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                d = sock.recv(65536)
                if not d:
                    break
                buf += d
            except socket.timeout:
                continue
            m = RESULT_RE.search(strip_iac(buf).decode("ascii", "replace"))
            if m:
                text = strip_iac(buf).decode("ascii", "replace")
                return text, m
        return strip_iac(buf).decode("ascii", "replace"), None
    finally:
        sock.close()


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--jit", action="store_true")
    ap.add_argument("--ram")
    ap.add_argument("--max-insn")
    ap.add_argument("--load")
    ap.add_argument("--frontend")
    ap.add_argument("--trace-count")
    ap.add_argument("--timeout", type=float,
                    default=float(os.environ.get("EMU_BOARD_TIMEOUT", "90")))
    ap.add_argument("image")
    args, _unknown = ap.parse_known_args()

    if not os.path.exists(args.image):
        sys.exit("emu-board: no such image: %s" % args.image)

    # One board, one run at a time.
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    try:
        with tempfile.TemporaryDirectory() as tmp:
            image, _what = prepare_image(args.image, args.load, tmp)

        try:
            text, m = run_on_board(image, args.timeout)
        except (OSError, RuntimeError) as e:
            print("emu-board: %s" % e, file=sys.stderr)
            return 125

        if not args.quiet:
            sys.stdout.write(text)
        else:
            # Even --quiet has to pass the guest's own output through:
            # the architecture tests self-report with an RVCP-SUMMARY
            # line and the harness greps stdout for it -- and the state
            # the run ended in, which is where a Berkeley test parked in
            # write_tohost leaves its verdict (run-riscv-tests.sh).
            state = False
            for line in text.splitlines():
                state = state or "-- guest state --" in line
                if state or "RVCP" in line or "SUMMARY" in line:
                    print(line)

        if m is None:
            print("emu-board: no result line within %.0fs" % args.timeout,
                  file=sys.stderr)
            return 124

        code, exited, capped, _retired = (int(x) for x in m.groups())
        if capped:
            print("emu-board: instruction cap reached", file=sys.stderr)
            return 124
        if not exited:
            # Halted without calling exit(). The host runner treats that
            # as a completed run with status 0, so match it rather than
            # inventing a failure the suites would not have seen.
            return 0
        return code & 0xFF
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


if __name__ == "__main__":
    sys.exit(main())
