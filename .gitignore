# Build trees. These also hold the fetched third-party material: the
# STM32Cube driver pack, the RISC-V test suites, the Sail golden model and
# the UDB gems. All of it is reproducible from the scripts, so none of it
# belongs in the repository.
/build/

# CMake
CMakeCache.txt
CMakeFiles/
compile_commands.json
cmake_install.cmake

# Firmware artefacts
*.elf
*.bin
*.hex
*.map
*.o
*.obj
*.a

# ...except the G4MH guests, which are *sources* as far as a checkout is
# concerned: CC-RH is the only compiler that emits G4MH and it is a
# licensed toolchain behind a docker image, so nobody who clones this can
# rebuild them. scripts/g4mh-build-guest.sh already documented them as
# committed; the blanket *.bin rule above meant they never were.
!tests/guest/g4mh/*.bin

# Editors
.vscode/
.idea/
*.swp
*~
.claude/worktrees/

# build-matrix.sh writes one log per configuration beside its build dir.
build/mx-*.log

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# The N6 control's build products; tools/n6-control/build.sh rebuilds them.
tools/n6-control/STM32CubeN6/

# The rv32 init is compiled from boot/initramfs/init.c; the binary is a
# build product and the kernel's CONFIG_INITRAMFS_SOURCE reads it from
# the working tree.
boot/initramfs/init
